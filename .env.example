# ══════════════════════════════════════════════════════════════════════════════
#  Rehab Swat CMS — Environment Variables
#  Copy this file to .env and fill in every value before running the app.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (required for production):
DATABASE_URL=postgresql://postgres:password@db:5432/rehabswat

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your production domain here (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cloudinary (document/photo storage — Phase 2) ─────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Twilio (WhatsApp / SMS reminders — Phase 3) ───────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
