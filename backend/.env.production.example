# ══════════════════════════════════════════════════════════════════════════════
#  Rehab Swat CMS — Production Environment Variables
#  Rename or copy this file to .env in your production environment.
#  NEVER commit the actual .env file containing real secrets to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Security ──────────────────────────────────────────────────────────────────
# CRITICAL: Generate a strong, secure 256-bit key for signing JWT tokens.
# You can generate this using the following terminal command:
#   openssl rand -hex 32
# Replace the value below with the generated hex string:
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# ── Database ───────────────────────────────────────────────────────────────────
# Production PostgreSQL URL (do not use SQLite in production)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@postgres_db_host:5432/rehabswat

# ── Redis ─────────────────────────────────────────────────────────────────────
# Production Redis connection string (used for rate limiting and Celery beat)
REDIS_URL=redis://redis_host:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed production frontend domains (NO trailing slashes)
CORS_ALLOWED_ORIGINS=https://app.rehabswat.pk,https://api.rehabswat.pk

# ── Cloudinary (Document/Photo storage - Phase 2) ─────────────────────────────
# Get this URL from your Cloudinary console dashboard
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Twilio (WhatsApp/SMS reminders - Phase 3) ─────────────────────────────────
# Get credentials from your Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Sentry Error Tracking (Phase 5) ───────────────────────────────────────────
# Get this DSN from your Sentry project settings
SENTRY_DSN=https://your_sentry_public_key@sentry.io/your_project_id
